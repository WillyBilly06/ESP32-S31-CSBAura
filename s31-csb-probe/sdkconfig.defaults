# CSB/CPB probe — we only need the controller + raw VHCI; no host stack.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# CSB/CPB is a BR/EDR (Classic) controller feature, so the controller must run
# a mode that INCLUDES Classic. The exact Kconfig symbol is chip/IDF specific —
# set it in menuconfig:
#   Component config -> Bluetooth -> Bluetooth controller
#     -> "Bluetooth controller mode" = BR/EDR + BLE (BTDM) / enable Classic
# The code falls back to BLE-only and reports if Classic isn't available.
# (Host stacks left OFF — we talk raw HCI through esp_vhci_host_*.)
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
