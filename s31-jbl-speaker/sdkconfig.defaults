# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
# Dual mode: BLE for Auracast + BR/EDR for phones (A2DP sink), like a JBL speaker
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SSP_ENABLED=y
# Unused Bluedroid features (the app never calls esp_avrc_*; AVRCP itself is
# hard-wired to A2DP in Bluedroid and stays). Cover Art pulls in GOEP client +
# OBEX + RFCOMM (rfc_cb ~2 KB .bss, plus their code and pools).
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set
# No LE DTM test commands. (BT_BLE_FEAT_ISO_BIG_SYNCER / ISO_CIG_CENTRAL /
# ISO_CIG_PERIPHERAL stay on although we only broadcast: the LE Audio host's
# Bluedroid adapter, esp_ble_iso/host/adapter/bluedroid/iso.c, uses their
# BTM CIS/BIG-sync APIs unconditionally and does not compile without them.)
# CONFIG_BT_BLE_50_DTM_TEST_EN is not set
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y
CONFIG_BT_ACL_CONNECTIONS=4
CONFIG_BT_BLE_FEAT_ISO_EN=y

CONFIG_BT_ISO_MAX_CHAN=2
# Lets us set the BIG layout explicitly (ISO interval, NSE, BN, IRC, PTO) to
# match the real Xtreme 5, via HCI LE Create BIG Test.
CONFIG_BT_ISO_TEST_PARAMS=y

CONFIG_BT_BAP_BROADCAST_SOURCE=y
# Stereo: one subgroup, two BIS (Front-Left + Front-Right), like a JBL broadcast.
CONFIG_BT_BAP_BROADCAST_SRC_SUBGROUP_COUNT=1
CONFIG_BT_BAP_BROADCAST_SRC_STREAM_COUNT=2

# Party role LISTEN (main/party_role.c): when the phone stops streaming the S31
# stops hosting and joins another JBL master's Auracast as a BAP broadcast sink
# (PA sync + BASE + BIG sync of 2 BIS). The sink needs the scan delegator
# (BASS) and a sink PAC record. Source and sink never run at the same time:
# one BIG (host BT_ISO_MAX_BIG / controller BT_LE_ISO_BIG = 1) is enough.
CONFIG_BT_BAP_SCAN_DELEGATOR=y
CONFIG_BT_BAP_BROADCAST_SINK=y
CONFIG_BT_BAP_BROADCAST_SNK_SUBGROUP_COUNT=1
CONFIG_BT_BAP_BROADCAST_SNK_STREAM_COUNT=2
CONFIG_BT_PAC_SNK_NOTIFIABLE=y
CONFIG_BT_PAC_SNK_LOC_WRITEABLE=y
CONFIG_BT_PAC_SNK_LOC_NOTIFIABLE=y
CONFIG_BT_PACS_SUPPORTED_CONTEXT_NOTIFIABLE=y
# GATT server services: JBL x3 + PACS + BASS + the built-in ones (8 was tight)
CONFIG_BT_GATT_MAX_SR_PROFILES=12

# PSRAM for audio buffers; small/time-critical allocations stay in internal SRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Deliberately OFF (internal heap is ~190 KB free after BT init, no pressure):
#  - SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY: moves ALL of libbt.a's .bss to PSRAM,
#    including the controller OSAL (btdm_osal_freertos.c event queues/callouts)
#    whose IRAM code runs from the controller ISR while the cache is off during
#    flash writes (NVS bonding) -> crash. App cold buffers use heap_caps_malloc
#    (MALLOC_CAP_SPIRAM) on first use instead.
#  - BT_ALLOCATION_FROM_SPIRAM_FIRST: functionally safe (VHCI is a RAM/memcpy
#    interface, no DMA; controller pools are its own), but it moves EVERY
#    osi_malloc to PSRAM, incl. the buffer of every HCI event and A2DP media
#    packet (the SBC decoder then reads them through the cache) and the
#    Bluedroid control blocks, on cores that are already the bottleneck.
#  - BT_BLE_DYNAMIC_ENV_MEMORY: without the option above the control blocks
#    just move from .bss to internal heap (< 16 KB each), no saving.

# 16 MB flash on the S31 board; dual-mode Bluetooth needs a bigger app slot
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000

# BASE metadata headroom (phones/finders send rich metadata)
CONFIG_BT_AUDIO_CODEC_CFG_MAX_METADATA_SIZE=128

# Two advertisers: Auracast broadcast + JBL host beacon
CONFIG_BT_LE_MAX_EXT_ADV_INSTANCES=2

# Coexistence tuning: max LE TX power for the Auracast stream, more BR/EDR RX buffers
CONFIG_BT_LE_DFT_TX_POWER_LEVEL_P20=y
# (Kconfig range is 4..8: the old value 10 was rejected and silently fell back to 6)
CONFIG_BT_CTRL_BR_EDR_ACLU_RX_BUF_NB=8

# Core layout. Core 0: BT controller "btdm" (prio 23, highest on its core) +
# esp_timer (22, drives the k_work TX scheduler) + Bluedroid hciT/BTU/BTC (22/20/19)
# + iso_task (20, follows the Bluedroid core) + LC3 encoder "lc3_enc" (21, main.c).
# Core 1: A2DP_DECODER (SBC decode + resampler; hard-pinned to core 1 in
# btc_a2dp_sink.c) + the low-priority app tasks. With everything except the
# controller on core 1, IDLE1 starved (task WDT) while core 0 sat idle.
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y

# HCI command buffer pool 5 -> 10. The crash after the WDT was assert(pkt) on the
# CMD buffer alloc (hci_driver_standard.c:191). ~1.3 KB heap. Mitigation only;
# the root cause was the core-1 overload.
CONFIG_BT_CTRL_HCI_CMD_NUM=10

# Execute in place from PSRAM: .text/.rodata are copied from flash to the octal
# PSRAM (200 MHz DDR) at boot, so I-cache misses (16 KB I-cache vs ~1.5 MB of
# Bluedroid + LE Audio + LC3 + SBC code) are filled from PSRAM, not DIO 80 MHz
# flash (~20x the bandwidth), and flash writes (NVS bonding) no longer freeze the
# cache on both cores. Costs ~1.8 MB of the 16 MB PSRAM and a slightly longer boot.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# FreeRTOS kernel (queues, semaphores, context switch) in IRAM: it runs for every
# A2DP packet, HCI packet and LC3 tick on both cores. +~17 KB IRAM.
CONFIG_FREERTOS_IN_IRAM=y


# Optimise for speed (-O2): the audio path (SBC decode, resampler, LC3) and Bluedroid
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Fast console: a log line blocks its task ~8x shorter than at 115200
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# Bluedroid: errors only (connection setup used to flood the UART)
CONFIG_BT_LOG_HCI_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_BTM_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_L2CAP_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_RFCOMM_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_SDP_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_GAP_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_BNEP_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_PAN_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_A2D_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_AVDT_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_AVCT_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_AVRC_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_MCA_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_HID_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_APPL_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_GATT_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_SMP_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_BTIF_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_BTC_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_OSI_TRACE_LEVEL_ERROR=y
CONFIG_BT_LOG_BLUFI_TRACE_LEVEL_ERROR=y

# Core layout: Bluetooth on core 1, audio DSP on core 0 (see CMakeLists.txt).
CONFIG_BT_CTRL_PINNED_TO_CORE_CHOICE_1=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_1=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
