# =========================================================================
# ESP32-S31 Auracast demo — defaults (verified against esp-idf @ad20ded6
# examples/bluetooth/esp_ble_audio/pbp/pbs + bap/broadcast_source).
# The LE-Audio API is a PREVIEW; confirm with `idf.py menuconfig`.
# =========================================================================

# ---- BT stack: Bluedroid host (the examples use Bluedroid) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=n          # pure-Auracast build; no Classic needed
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y

# ---- LE Audio / Isochronous ----
CONFIG_BT_BLE_FEAT_ISO_EN=y
CONFIG_BT_ISO_MAX_CHAN=2

# ---- Roles ----
# Broadcast SOURCE (transmit / Auracast sender) + PBP public broadcast:
CONFIG_BT_BAP_BROADCAST_SOURCE=y
CONFIG_BT_CAP_INITIATOR=y
CONFIG_BT_PBP=y
# Broadcast SINK (receive) — enable when you wire the receive_start() path
# (symbols per the pbp/pbk example):
# CONFIG_BT_BAP_BROADCAST_SINK=y     # (VERIFY against pbk sdkconfig.defaults)
# CONFIG_BT_CAP_ACCEPTOR=y

# ---- Misc ----
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y   # LE-Audio binary is big
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
