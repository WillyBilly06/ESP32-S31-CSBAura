--- a/components/bt/host/bluedroid/stack/a2dp/a2d_sbc.c
+++ b/components/bt/host/bluedroid/stack/a2dp/a2d_sbc.c
@@ (static const tA2D_SBC_CIE a2dp_sbc_sink_caps, last field) @@
     A2D_SBC_IE_MAX_BITPOOL, /* max_bitpool */
+#if defined(A2D_SBC_SINK_MIN_BITPOOL)
+    /* local patch (s31-jbl-speaker): advertise a high minimum bitpool so the
+     * phone's SBC encoder cannot adapt down (Android raises its bitrate until
+     * the bitpool reaches the sink's minimum). */
+    A2D_SBC_SINK_MIN_BITPOOL /* min_bitpool */
+#else
     A2D_SBC_IE_MIN_BITPOOL /* min_bitpool */
+#endif
 };
--- a/components/bt/host/bluedroid/btc/profile/std/a2dp/bta_av_co.c
+++ b/components/bt/host/bluedroid/btc/profile/std/a2dp/bta_av_co.c
@@ (end of bta_av_build_src_cfg: used when the sink initiates and picks the config) @@
     if (!A2DP_BuildCodecConfig(p_src_cap, p_pref_cfg)) {
         APPL_TRACE_ERROR("%s unsupported codec_index %s", __func__,
                          A2DP_CodecName(p_pref_cfg));
     }
+#if defined(A2D_SBC_SINK_MIN_BITPOOL)
+    if (p_pref_cfg[2] == A2D_MEDIA_CT_SBC) {
+        UINT8 max_bp = p_pref_cfg[BTA_AV_CO_SBC_MAX_BITPOOL_OFF];
+        UINT8 min_bp = A2D_SBC_SINK_MIN_BITPOOL < max_bp ? A2D_SBC_SINK_MIN_BITPOOL : max_bp;
+        if (p_pref_cfg[BTA_AV_CO_SBC_MIN_BITPOOL_OFF] < min_bp) {
+            p_pref_cfg[BTA_AV_CO_SBC_MIN_BITPOOL_OFF] = min_bp;
+        }
+    }
+#endif
 }
