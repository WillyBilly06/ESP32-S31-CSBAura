--- a/components/bt/host/bluedroid/stack/btm/btm_acl.c
+++ b/components/bt/host/bluedroid/stack/btm/btm_acl.c
@@ (BTM_SetLinkPolicy, before "First, check if hold mode is supported") @@
+#if defined(BTM_NO_ROLE_SWITCH) && BTM_NO_ROLE_SWITCH
+    /* local patch (s31-jbl-speaker): never allow a role switch on BR/EDR links.
+     * The S31 must stay central/master so its controller can schedule the
+     * phone's A2DP packets around the LE Audio BIG. */
+    *settings &= (~HCI_ENABLE_MASTER_SLAVE_SWITCH);
+#endif
     /* First, check if hold mode is supported */
     if (*settings != HCI_DISABLE_ALL_LM_MODES) {
@@ (BTM_SetDefaultLinkPolicy, after "UINT8 *localFeatures = BTM_ReadLocalFeatures();") @@
     UINT8 *localFeatures = BTM_ReadLocalFeatures();
+#if defined(BTM_NO_ROLE_SWITCH) && BTM_NO_ROLE_SWITCH
+    settings &= ~HCI_ENABLE_MASTER_SLAVE_SWITCH;   /* local patch: stay master */
+#endif
