diff --git a/components/bt/host/bluedroid/api/esp_gatts_api.c b/components/bt/host/bluedroid/api/esp_gatts_api.c
index c93b2bdc..361dcf45 100644
--- a/components/bt/host/bluedroid/api/esp_gatts_api.c
