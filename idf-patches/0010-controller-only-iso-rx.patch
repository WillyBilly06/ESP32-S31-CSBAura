diff --git a/components/bt/porting_btdm/transport/src/hci_transport.c b/components/bt/porting_btdm/transport/src/hci_transport.c
index 6674e619..a5e22628 100644
--- a/components/bt/porting_btdm/transport/src/hci_transport.c
+++ b/components/bt/porting_btdm/transport/src/hci_transport.c
@@ -173,7 +173,10 @@ hci_transport_controller_le_iso_tx(const uint8_t *data, uint16_t len, void *arg)
 #if CONFIG_BT_NIMBLE_ENABLED
     return s_hci_transport_env.driver_ops->hci_driver_tx(HCI_DRIVER_TYPE_ISO, (uint8_t *)data, len,
